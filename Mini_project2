class KeywordFrequencyCounter:
    def __init__(self, size=100):
        self.size = size
        self.table = [[] for i in range(size)]

    # Hash function
    def hash_function(self, word):
        return sum(ord(ch) for ch in word) % self.size

    # Insert keyword or update frequency
    def insert(self, word):
        index = self.hash_function(word)

        for item in self.table[index]:
            if item[0] == word:
                item[1] += 1
                return

        self.table[index].append([word, 1])

    # Count keywords from user text
    def count_keywords(self, text):
        self.table = [[] for i in range(self.size)]

        words = text.lower().split()

        for word in words:
            word = word.strip(".,!?;:\"'()[]{}")

            if word:
                self.insert(word)

        print("Keyword frequencies counted successfully!")

    # Display all keyword frequencies
    def display(self):
        found = False
        print("\n--- Keyword Frequencies ---")

        for bucket in self.table:
            for word, frequency in bucket:
                print(word, ":", frequency)
                found = True

        if not found:
            print("No keywords available.")

    # Search for a keyword
    def search(self, word):
        word = word.lower().strip(".,!?;:\"'()[]{}")
        index = self.hash_function(word)

        for item in self.table[index]:
            if item[0] == word:
                print("Keyword:", word)
                print("Frequency:", item[1])
                return

        print("Keyword not found.")

    # Find the most frequent keyword
    def most_frequent(self):
        words = [
            item
            for bucket in self.table
            for item in bucket
        ]

        if not words:
            print("No keywords available.")
            return

        maximum = max(item[1] for item in words)

        print("\nMost Frequent Keyword(s):")
        for word, frequency in words:
            if frequency == maximum:
                print(word, ":", frequency)


# Main program
counter = KeywordFrequencyCounter()

while True:
    print("\n===== KEYWORD FREQUENCY COUNTER =====")
    print("1. Enter Text and Count Keywords")
    print("2. Display Frequencies")
    print("3. Search Keyword")
    print("4. Find Most Frequent Keyword")
    print("5. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        text = input("Enter text: ")

        if text.strip():
            counter.count_keywords(text)
        else:
            print("Text cannot be empty.")

    elif choice == "2":
        counter.display()

    elif choice == "3":
        word = input("Enter keyword to search: ")
        counter.search(word)

    elif choice == "4":
        counter.most_frequent()

    elif choice == "5":
        print("Program ended.")
        break

    else:
        print("Invalid choice. Please try again.")
